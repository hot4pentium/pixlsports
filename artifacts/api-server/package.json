{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "run:game-on-alerts": "node --enable-source-maps ./dist/gameOnAlertsCli.mjs",
    "run:game-on-alerts-trigger": "node --enable-source-maps ./dist/gameOnAlertsTriggerCli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@google-cloud/storage": "^8.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.0.2",
    "html-to-text": "^10.0.1",
    "http-proxy-middleware": "^4.2.0",
    "jose": "^6.2.13",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "svix": "^2.8.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
