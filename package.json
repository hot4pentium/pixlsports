{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test:account-lifecycle": "pnpm --filter @workspace/league-matrix-studio exec tsx --test ../api-server/src/accountLifecycle.test.ts",
    "test:coach-calendar-subscription": "pnpm --filter @workspace/league-matrix-studio exec tsx --test ../api-server/src/coachCalendarSubscription.test.ts",
    "test:supporter-photo-policy": "pnpm --filter @workspace/league-matrix-studio exec tsx --test ../api-server/src/supporterPhotoPolicy.test.ts",
    "test:checklist-sharing": "pnpm --filter @workspace/league-matrix-studio exec tsx --test ../api-server/src/checklistShares.test.ts src/features/checklist-sharing.browser.test.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
