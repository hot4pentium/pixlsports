modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "showcase-responsive-browser"

[[workflows.workflow]]
name = "showcase-responsive-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/league-matrix-studio test:showcase-responsive-browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild", "firefox", "webkitgtk_4_1", "geckodriver", "xorg.xorgserver", "xorg.xauth", "mesa"]

[userenv]

[userenv.shared]
VAPID_SUBJECT = "https://pixlsports.com/help"

[userenv.production]
PIXL_INITIAL_ADMIN_EMAIL = "hot4pentium@gmail.com"
RESEND_INBOUND_DOMAIN = "rexuas.resend.app"

[userenv.development]
NATIVE_IOS_CLERK_ISSUER = "https://healthy-feline-9810.clerk.accounts.dev"
